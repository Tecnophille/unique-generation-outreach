# ── Hosting ──────────────────────────────────────────────
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
TRUST_PROXY=1
SITE_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app
COOKIE_SECURE=1
SESSION_DAYS=7

# ── Supabase Postgres (required on Vercel) ───────────────
# Project Settings → Database → Connection string → URI
# Prefer the "Transaction" pooler URI for the serverless API.
CMS_DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Direct (non-pooler) URI is best for migrations:
DATABASE_URL_UNPOOLED=postgresql://postgres.xxxx:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
# Aliases also accepted: SUPABASE_DB_URL, DATABASE_URL, SUPABASE_DB_URL_DIRECT

# ── Supabase Storage (required for CMS uploads on Vercel) ─
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=ugo-media

# ── CMS admin ────────────────────────────────────────────
CMS_ADMIN_EMAIL=admin@ugo.local
CMS_ADMIN_NAME=UGO Admin
CMS_ADMIN_PASSWORD=change-me-to-a-long-random-secret

# Optional SSL knobs (Supabase defaults to SSL on)
# DB_SSL=1
# DB_SSL_REJECT_UNAUTHORIZED=0
