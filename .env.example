# Runtime
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
TRUST_PROXY=1

# Public site URL (no trailing slash) — used for CORS + sitemap
SITE_URL=https://example.com
CORS_ORIGIN=https://example.com

# Database — leave empty for local PGlite; Cursor publish sets this automatically
DATABASE_URL=

# CMS admin (set these in production / Cursor Secrets)
CMS_ADMIN_EMAIL=admin@ugo.local
CMS_ADMIN_NAME=UGO Admin
CMS_ADMIN_PASSWORD=change-me-to-a-long-random-secret

# Cookies
COOKIE_SECURE=1
SESSION_DAYS=7
