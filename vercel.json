{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/", "destination": "/api/spa?spaPath=/" },
    { "source": "/((?!api/).+)", "destination": "/api/spa?spaPath=/$1" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{migrations/**,public/cms/**,server/**,src/cms/**}",
      "maxDuration": 30
    },
    "api/sitemap.js": {
      "includeFiles": "{migrations/**,public/cms/**,server/**,src/cms/**}",
      "maxDuration": 30
    },
    "api/robots.js": {
      "includeFiles": "{migrations/**,public/cms/**,server/**,src/cms/**}",
      "maxDuration": 30
    },
    "api/spa.js": {
      "includeFiles": "{migrations/**,public/cms/**,server/**,src/cms/**,dist/index.html}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
